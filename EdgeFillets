Private Function CountGroup(dRad As Double) As Long
    Dim m As Long
    Dim n As Long
    n = 0
    For m = 0 To gCount - 1
        If gRadii(m) = dRad Then n = n + 1
    Next m
    CountGroup = n
End Function
