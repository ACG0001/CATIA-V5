Private Function BuildReport() As String
    Dim m          As Long
    Dim curRad     As Double
    Dim groupCount As Long
    Dim sReport    As String
    curRad     = -1
    groupCount = 0
    sReport    = "NON-STANDARD FILLETS REPORT" & vbCrLf
